# =============================================================================
# GoalBook Environment Variables Configuration (.env.example)
# Copy this file to .env or .env.local for local development.
# In Expo SDK 54, variables prefixed with EXPO_PUBLIC_ are embedded into the client bundle.
# =============================================================================

# --- Backend API Endpoints ---
# URL for the Node/Express User & Book Management Microservice
EXPO_PUBLIC_USER_API_URL=http://localhost:5000/api

# URL for the Python FastApi AI Microservice (embeddings, text chunking, summaries)
EXPO_PUBLIC_AI_API_URL=http://localhost:8000

# --- OpenAI Direct Integration (Optional / Fallback) ---
# Used for direct OpenAI GPT query fallback if AI microservice is unreachable
EXPO_PUBLIC_OPENAI_API_KEY=sk-proj-yourOpenAiApiKeyHere

# --- Sentry Error Monitoring & Telemetry ---
# Your Sentry Project DSN (Data Source Name)
EXPO_PUBLIC_SENTRY_DSN=https://examplePublicKey@o000000.ingest.sentry.io/0000000
EXPO_PUBLIC_ENABLE_SENTRY=false
EXPO_PUBLIC_ENV=development

# --- Vercel Web Analytics ---
# Required when deploying Web app to Vercel (optional for localhost)
EXPO_PUBLIC_VERCEL_ANALYTICS_ID=prj_yourVercelAnalyticsId

# --- Database & Prisma (Server-side) ---
# PostgreSQL connection string for Prisma schema migrations & microservices
DATABASE_URL="postgresql://admin:admin123@65.2.161.214:5000/GoalBookDB"

# --- Cypress E2E Testing ---
CYPRESS_BASE_URL=http://localhost:8081
