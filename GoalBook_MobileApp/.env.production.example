# =============================================================================
# GoalBook Production Environment Variables Template (.env.production.example)
# Configure these variables in Vercel Project Settings -> Environment Variables
# =============================================================================

# Production API Microservice Endpoints
EXPO_PUBLIC_USER_API_URL=https://api.goalbook.app/api
EXPO_PUBLIC_AI_API_URL=https://ai.goalbook.app

# OpenAI Production Key
EXPO_PUBLIC_OPENAI_API_KEY=sk-proj-productionKeyHere

# Sentry Production DSN
EXPO_PUBLIC_SENTRY_DSN=https://prodKey@o000000.ingest.sentry.io/0000000
EXPO_PUBLIC_ENABLE_SENTRY=true
EXPO_PUBLIC_ENV=production

# Vercel Production Analytics
EXPO_PUBLIC_VERCEL_ANALYTICS_ID=prj_goalbookProductionId

# PostgreSQL Cloud Database
DATABASE_URL="postgresql://db_user:secure_password@db-host.neon.tech/goalbook?sslmode=require"
