# ==============================================================================
# GoalBook Environment Variables Template
# Copy this file to .env.local and fill in your credentials
# ==============================================================================

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# PostgreSQL Database (Prisma ORM)
DATABASE_URL="postgresql://user:password@localhost:5432/goalbook?schema=public"

# Google Gemini AI (Q&A and Summarization)
GEMINI_API_KEY="AIzaSy..."

# ImageKit Cloud Storage (Book Uploads & Sync)
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="public_..."
IMAGEKIT_PRIVATE_KEY="private_..."
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_endpoint"

# Monitoring & Analytics (Optional)
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=""
